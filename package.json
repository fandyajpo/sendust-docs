{
  "name": "sendust-docs",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Renders the Sendust documentation from fandyajpo/sendust as an Astro Starlight site.",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.23.5",
    "npm": ">=12.2.2"
  },
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "check:docs": "node scripts/sync-docs.mjs --check",
    "fetch:docs": "node scripts/fetch-sendust.mjs",
    "dev": "astro dev",
    "build": "npm run sync:docs && astro build",
    "build:vercel": "npm run fetch:docs && npm run build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.37.7",
    "astro": "^5.18.2",
    "motion": "^14.14.0"
  }
}
