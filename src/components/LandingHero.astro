---
import SignalMoth from "./SignalMoth.astro";

/**
 * The landing hero: the canvas itself, washed with the mesh, the promise in
 * display type, and the signal moth perched beside it. Every claim in it is a
 * fact the synced documentation states; nothing here is a promise the project
 * has not made.
 */
---

<section
  class="sx-hero"
  aria-labelledby="sx-hero-title"
  data-pagefind-meta="title:Sendust documentation"
>
  <div class="sx-hero__inner">
    <div class="sx-hero__copy">
      <p class="sx-eyebrow">
        <span class="sx-eyebrow__dot" aria-hidden="true"></span>
        <span>
          v1.0.1 · Rust core<span class="sx-eyebrow__more"> · Node, Bun, Deno</span>
        </span>
      </p>

      <h1 class="sx-hero__title" id="sx-hero-title" data-pagefind-ignore>
        <span class="sx-hero__line"><span>Email infrastructure,</span></span>
        <span class="sx-hero__line">
          <span>
            engineered for{" "}
            <span class="sx-rotor" aria-hidden="true">
              <span>efficiency.</span>
              <span>reliability.</span>
              <span>precision.</span>
              <span>simplicity.</span>
            </span>
            <span class="sx-sr">efficiency, reliability, precision and simplicity.</span>
          </span>
        </span>
      </h1>

      <p class="sx-hero__tagline">
        A Rust core, a Node-API addon and a typed SDK. One transport that queues, pools its
        sessions, and reports exactly what the relay said.
      </p>

      <p class="sx-hero__actions">
        <a class="sx-btn sx-btn--primary" href="guide/quick-start/">
          Quick start
          <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true" shape-rendering="crispEdges">
            <path d="M1 5.25 H7 V3 L11 6 L7 9 V6.75 H1 Z" fill="currentColor"></path>
          </svg>
        </a>
        <a class="sx-btn sx-btn--ghost" href="architecture/overview/">Architecture</a>
      </p>

      <p class="sx-hero__note">
        The native addon ships per platform, with no Rust toolchain and no build step on your side.
      </p>
    </div>

    <div class="sx-hero__moth"><SignalMoth variant="perch" /></div>
  </div>
</section>
