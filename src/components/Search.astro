---
/**
 * The search trigger: the site's own control, not a borrowed one. The dialog
 * it opens lives beside the header in Header.astro, so no header ancestor can
 * clip it; UiScripts.astro wires the two together.
 */
---

<button class="sx-searchbtn" type="button" data-search-open aria-label="Search the documentation">
  <svg
    class="sx-searchbtn__icon"
    viewBox="0 0 16 16"
    width="15"
    height="15"
    aria-hidden="true"
    shape-rendering="crispEdges"
  >
    <path
      d="M6.5 3 H9.5 V4 H11 V5.5 H12 V8.5 H11 V10 H9.5 V11 H6.5 V10 H5 V8.5 H4 V5.5 H5 V4 H6.5 Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"></path>
    <rect x="10.4" y="9.6" width="1.4" height="1.4" fill="currentColor"></rect>
    <rect x="11.8" y="11" width="1.4" height="1.4" fill="currentColor"></rect>
    <rect x="13.2" y="12.4" width="1.4" height="1.4" fill="currentColor"></rect>
  </svg>
  <span class="sx-searchbtn__text">Search</span>
  <kbd class="sx-searchbtn__key" aria-hidden="true">⌘K</kbd>
</button>
