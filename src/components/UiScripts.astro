<script>
  /**
   * One behaviour layer for the custom controls: the header dropdowns, the
   * select panels, the mobile drawer and search. Everything is delegated from
   * the document and re-resolved by hand, so a view transition leaves no
   * listener or stale node behind.
   */

  const doc = document;
  const root = doc.documentElement;

  let pagefind: Promise<Record<string, unknown>> | null = null;
  let searchTimer = 0;

  /* -------------------------------------------------------------- scrolling */

  function lockScroll(locked: boolean): void {
    const value = locked ? "hidden" : "";
    root.style.overflow = value;
    doc.body.style.overflow = value;
  }

  /* The page behind a modal is inert, not merely covered: a keyboard or a
     screen reader must not reach it. The header itself stays live, because both
     the drawer and the search dialog are rendered inside it. */
  function setBackgroundInert(inert: boolean): void {
    for (const el of doc.querySelectorAll("main, #starlight__sidebar")) {
      if (inert) el.setAttribute("inert", "");
      else el.removeAttribute("inert");
    }
  }

  /* ------------------------------------------------------------- open state */

  function closeMenus(): void {
    for (const item of doc.querySelectorAll("[data-menu][data-open]")) {
      item.removeAttribute("data-open");
      item.querySelector("[data-menu-trigger]")?.setAttribute("aria-expanded", "false");
    }
  }

  function closeSelects(): void {
    for (const select of doc.querySelectorAll("[data-select][data-open]")) {
      select.removeAttribute("data-open");
      const trigger = select.querySelector("[data-select-trigger]");
      trigger?.setAttribute("aria-expanded", "false");
      trigger?.removeAttribute("aria-activedescendant");
      for (const option of select.querySelectorAll("[data-select-option]")) {
        option.classList.remove("is-active");
      }
    }
  }

  function closeDrawer(): void {
    const drawer = doc.getElementById("sx-drawer");
    if (!drawer?.hasAttribute("data-open")) return;
    // A select left open inside the drawer would keep its chevron flipped.
    closeSelects();
    const inside = drawer.contains(doc.activeElement);
    drawer.removeAttribute("data-open");
    lockScroll(false);
    setBackgroundInert(false);
    const burger = doc.querySelector<HTMLElement>("[data-drawer-open]");
    burger?.setAttribute("aria-expanded", "false");
    // Escape and the close button hand the keyboard back to what opened it.
    if (inside) burger?.focus();
  }

  function openDrawer(): void {
    const drawer = doc.getElementById("sx-drawer");
    if (!drawer) return;
    closeMenus();
    closeSelects();
    // Two modals at once is a bug: the drawer takes over from the search.
    closeSearch();
    // A drawer left scrolled would reopen somewhere in its middle.
    const panel = drawer.querySelector<HTMLElement>(".sx-drawer__panel");
    if (panel) panel.scrollTop = 0;
    drawer.setAttribute("data-open", "");
    lockScroll(true);
    setBackgroundInert(true);
    doc.querySelector("[data-drawer-open]")?.setAttribute("aria-expanded", "true");
    // The close button, not the scrim: the scrim is not focusable.
    drawer.querySelector<HTMLElement>(".sx-drawer__close")?.focus();
  }

  function closeSearch(): void {
    const dialog = doc.querySelector("[data-search-dialog]");
    if (!dialog?.hasAttribute("data-open")) return;
    const inside = dialog.contains(doc.activeElement);
    dialog.removeAttribute("data-open");
    lockScroll(false);
    setBackgroundInert(false);
    if (inside) doc.querySelector<HTMLElement>("[data-search-open]")?.focus();
  }

  function closeEverything(): void {
    closeMenus();
    closeSelects();
    closeDrawer();
    closeSearch();
  }

  /* ---------------------------------------------------------------- dropdown */

  function openMenu(item: Element): void {
    closeMenus();
    closeSelects();
    item.setAttribute("data-open", "");
    item.querySelector("[data-menu-trigger]")?.setAttribute("aria-expanded", "true");
  }

  /* ------------------------------------------------------------------ select */

  function optionsOf(select: Element): HTMLElement[] {
    return Array.from(select.querySelectorAll<HTMLElement>("[data-select-option]"));
  }

  function markActive(select: Element, index: number): void {
    const options = optionsOf(select);
    options.forEach((option, at) => option.classList.toggle("is-active", at === index));
    const active = options[index];
    if (active) {
      select.querySelector("[data-select-trigger]")?.setAttribute("aria-activedescendant", active.id);
    }
  }

  function openSelect(select: Element): void {
    closeMenus();
    closeSelects();
    select.setAttribute("data-open", "");
    select.querySelector("[data-select-trigger]")?.setAttribute("aria-expanded", "true");
    const options = optionsOf(select);
    const current = options.findIndex((option) => option.getAttribute("aria-selected") === "true");
    markActive(select, current < 0 ? 0 : current);
  }

  function choose(select: Element, option: Element): void {
    const value = option.getAttribute("data-value") ?? "";
    const label = option.getAttribute("data-label") ?? value;
    select.setAttribute("data-value", value);
    for (const each of optionsOf(select)) {
      each.setAttribute("aria-selected", each === option ? "true" : "false");
    }
    const valueEl = select.querySelector("[data-select-value]");
    if (valueEl) valueEl.textContent = label;
    closeSelects();
    select.querySelector<HTMLElement>("[data-select-trigger]")?.focus();
    select.dispatchEvent(
      new CustomEvent("select:change", { bubbles: true, detail: { value, label } }),
    );
  }

  /* ------------------------------------------------------------------- theme */

  function syncThemeSelects(mode: string): void {
    for (const select of doc.querySelectorAll('[data-select][data-select-name="theme"]')) {
      const option = select.querySelector(`[data-select-option][data-value="${mode}"]`);
      if (!option) continue;
      select.setAttribute("data-value", mode);
      for (const each of optionsOf(select)) {
        each.setAttribute("aria-selected", each === option ? "true" : "false");
      }
      const valueEl = select.querySelector("[data-select-value]");
      if (valueEl) valueEl.textContent = option.getAttribute("data-label") ?? mode;
    }
  }

  function storedTheme(): string {
    try {
      const stored = localStorage.getItem("starlight-theme");
      if (stored === "" || stored === "auto") return "auto";
      if (stored === "light" || stored === "dark") return stored;
    } catch {
      /* storage can be blocked; the canvas is the site's default anyway */
    }
    return "light";
  }

  function applyTheme(mode: string): void {
    const resolved =
      mode === "auto"
        ? window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light"
        : mode;
    // One frame with no transitions, so the new palette lands in one step
    // instead of each element animating from the colour it is leaving.
    root.setAttribute("data-theme-snap", "");
    root.dataset.theme = resolved;
    // Read layout so the new colours are committed before transitions return.
    void root.offsetHeight;
    requestAnimationFrame(() => root.removeAttribute("data-theme-snap"));
    try {
      // "" is how Starlight records "follow the system".
      localStorage.setItem("starlight-theme", mode === "auto" ? "" : mode);
    } catch {
      /* nothing to persist to */
    }
    syncThemeSelects(mode);
  }

  /* ------------------------------------------------------------------ search */

  function status(text: string, tone: string): void {
    const el = doc.querySelector("[data-search-status]");
    if (!el) return;
    el.textContent = text;
    el.setAttribute("data-tone", tone);
  }

  const SEARCH_HINT = "Type to search. Up and down to choose, Enter to open, Escape to close.";

  /** Arms one result, so Enter opens it without the pointer. */
  function setActiveResult(dialog: Element, index: number): void {
    const results = Array.from(dialog.querySelectorAll<HTMLAnchorElement>(".sx-search__result"));
    results.forEach((item, at) => {
      if (at === index) item.dataset.active = "true";
      else delete item.dataset.active;
    });

    const chosen = results[index];
    if (!chosen) return;
    chosen.scrollIntoView({ block: "nearest" });
    dialog.querySelector("input")?.setAttribute("aria-activedescendant", chosen.id);
  }

  function loadPagefind(): Promise<Record<string, unknown>> {
    if (!pagefind) {
      const url = `${import.meta.env.BASE_URL}pagefind/pagefind.js`;
      pagefind = import(/* @vite-ignore */ url).then((module: Record<string, unknown>) => {
        const maybe = (module as { default?: Record<string, unknown> }).default;
        return maybe && typeof maybe.search === "function" ? maybe : module;
      });
    }
    return pagefind;
  }

  async function runSearch(query: string): Promise<void> {
    const list = doc.querySelector("[data-search-results]");
    if (!list) return;

    const q = query.trim();
    if (q.length < 2) {
      list.replaceChildren();
      delete (list as HTMLElement).dataset.scroll;
      status(q ? "One more character." : SEARCH_HINT, "");
      return;
    }

    status("Searching…", "");
    try {
      const pf = (await loadPagefind()) as {
        search: (term: string) => Promise<{ results?: { data: () => Promise<Record<string, unknown>> }[] }>;
      };
      const found = await pf.search(q);
      const items = await Promise.all((found.results ?? []).slice(0, 8).map((hit) => hit.data()));
      list.replaceChildren();

      if (items.length === 0) {
        status(`Nothing matched “${q}”.`, "empty");
        return;
      }

      status(`${items.length} result${items.length === 1 ? "" : "s"} for “${q}”`, "");

      let index = 0;
      for (const item of items) {
        const li = doc.createElement("li");
        // The list arrives in order; the stylesheet turns the index into a delay.
        li.style.setProperty("--i", String(index));
        const link = doc.createElement("a");
        link.id = `sx-search-result-${index}`;
        index += 1;
        link.href = String(item.url ?? "#");
        link.className = "sx-search__result";

        const title = doc.createElement("span");
        title.className = "sx-search__result-title";
        const meta = item.meta as { title?: string } | undefined;
        title.textContent = meta?.title ?? String(item.url ?? "");

        const excerpt = doc.createElement("span");
        excerpt.className = "sx-search__result-excerpt";
        // Pagefind marks matches with <mark>; nothing else in the excerpt is
        // trusted as markup.
        excerpt.innerHTML = String(item.excerpt ?? "").replace(/<(?!\/?mark\b)[^>]*>/gi, "");

        link.append(title, excerpt);
        li.append(link);
        list.append(li);
      }

      // The first result is armed, so a typed query can be opened with Enter,
      // and the list says whether there is more below its own edge.
      const dialog = list.closest("[data-search-dialog]");
      if (dialog) setActiveResult(dialog, 0);

      const scroller = list as HTMLElement;
      if (scroller.scrollHeight > scroller.clientHeight + 2) scroller.dataset.scroll = "more";
      else delete scroller.dataset.scroll;
    } catch {
      status("Search is unavailable here. Every page is in the menu.", "error");
    }
  }

  function openSearch(): void {
    const dialog = doc.querySelector("[data-search-dialog]");
    if (!dialog) return;
    closeMenus();
    closeSelects();
    closeDrawer();
    dialog.setAttribute("data-open", "");
    lockScroll(true);
    setBackgroundInert(true);
    const input = dialog.querySelector<HTMLInputElement>("input");
    input?.focus();
    if (input && input.value.trim().length > 1) void runSearch(input.value);
    else status(SEARCH_HINT, "");
  }

  /* ------------------------------------------------------------------- focus */

  function trapFocus(container: Element, event: KeyboardEvent): void {
    if (event.key !== "Tab") return;
    const focusables = Array.from(
      container.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((el) => el.offsetParent !== null || el === doc.activeElement);
    if (focusables.length === 0) return;

    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = doc.activeElement as HTMLElement | null;

    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  }

  /* ------------------------------------------------------------------ events */

  function handleClick(event: MouseEvent): void {
    const target = event.target as Element | null;
    if (!target) return;

    const menuTrigger = target.closest("[data-menu-trigger]");
    if (menuTrigger) {
      const item = menuTrigger.closest("[data-menu]");
      if (item) {
        if (item.hasAttribute("data-open")) closeMenus();
        else openMenu(item);
      }
      return;
    }

    if (target.closest("[data-menu-panel] a")) {
      closeMenus();
      return;
    }

    const selectTrigger = target.closest("[data-select-trigger]");
    if (selectTrigger) {
      const select = selectTrigger.closest("[data-select]");
      if (select) {
        if (select.hasAttribute("data-open")) closeSelects();
        else openSelect(select);
      }
      return;
    }

    const option = target.closest("[data-select-option]");
    if (option) {
      const select = option.closest("[data-select]");
      if (select) choose(select, option);
      return;
    }

    if (target.closest("[data-drawer-open]")) {
      openDrawer();
      return;
    }

    if (target.closest("[data-drawer-close]") || target.closest(".sx-drawer__nav a")) {
      closeDrawer();
      return;
    }

    if (target.closest("[data-search-open]")) {
      openSearch();
      return;
    }

    if (target.closest("[data-search-close]") || target.closest("[data-search-results] a")) {
      closeSearch();
      return;
    }

    const clear = target.closest("[data-field-clear]");
    if (clear) {
      const field = clear.closest("[data-field]");
      const input = field?.querySelector<HTMLInputElement>("input");
      if (input) {
        input.value = "";
        input.focus();
        input.dispatchEvent(new Event("input", { bubbles: true }));
      }
      return;
    }

    if (!target.closest("[data-select], .sx-nav__panel, .sx-search__panel, .sx-drawer__panel")) {
      closeMenus();
      closeSelects();
    }
  }

  function handleKeydown(event: KeyboardEvent): void {
    const key = event.key;

    if ((key === "k" || key === "K") && (event.metaKey || event.ctrlKey)) {
      event.preventDefault();
      openSearch();
      return;
    }

    if (key === "Escape") {
      const search = doc.querySelector("[data-search-dialog][data-open]");
      if (search) {
        closeSearch();
        return;
      }
      const drawer = doc.querySelector("[data-drawer][data-open]");
      if (drawer) {
        closeDrawer();
        return;
      }
      const select = doc.querySelector("[data-select][data-open]");
      if (select) {
        closeSelects();
        select.querySelector<HTMLElement>("[data-select-trigger]")?.focus();
        return;
      }
      const item = doc.querySelector("[data-menu][data-open]");
      if (item) {
        closeMenus();
        item.querySelector<HTMLElement>("[data-menu-trigger]")?.focus();
      }
      return;
    }

    const openDialog = doc.querySelector("[data-search-dialog][data-open]");
    if (openDialog) {
      const results = Array.from(openDialog.querySelectorAll<HTMLAnchorElement>(".sx-search__result"));

      if (results.length > 0 && (key === "ArrowDown" || key === "ArrowUp")) {
        event.preventDefault();
        const delta = key === "ArrowDown" ? 1 : -1;
        const at = results.findIndex((item) => item.dataset.active === "true");
        const from = at < 0 ? (delta > 0 ? -1 : 0) : at;
        setActiveResult(openDialog, (from + delta + results.length) % results.length);
        return;
      }

      if (key === "Enter") {
        const armed = results.find((item) => item.dataset.active === "true");
        if (armed) {
          event.preventDefault();
          armed.click();
          return;
        }
      }

      trapFocus(openDialog, event);
      return;
    }

    const openDrawerEl = doc.querySelector("[data-drawer][data-open]");
    if (openDrawerEl) {
      trapFocus(openDrawerEl, event);
      return;
    }

    const active = doc.querySelector("[data-select][data-open]");
    if (active) {
      const options = optionsOf(active);
      const at = options.findIndex((option) => option.classList.contains("is-active"));

      if (key === "ArrowDown" || key === "ArrowUp") {
        event.preventDefault();
        const delta = key === "ArrowDown" ? 1 : -1;
        const next = (at + delta + options.length) % options.length;
        markActive(active, next);
        options[next]?.scrollIntoView({ block: "nearest" });
        return;
      }

      if (key === "Home" || key === "End") {
        event.preventDefault();
        markActive(active, key === "Home" ? 0 : options.length - 1);
        return;
      }

      if ((key === "Enter" || key === " ") && options[at]) {
        event.preventDefault();
        choose(active, options[at]);
        return;
      }

      if (key === "Tab") closeSelects();
      return;
    }

    const openItem = doc.querySelector("[data-menu][data-open]");
    if (openItem) {
      const links = Array.from(openItem.querySelectorAll<HTMLElement>("[data-menu-panel] a"));
      const at = links.indexOf(doc.activeElement as HTMLElement);

      if (key === "ArrowDown") {
        event.preventDefault();
        (links[at + 1] ?? links[0])?.focus();
        return;
      }

      if (key === "ArrowUp") {
        event.preventDefault();
        (links[at - 1] ?? links[links.length - 1])?.focus();
        return;
      }

      if (key === "Tab") closeMenus();
    }
  }

  function handleInput(event: Event): void {
    const input = (event.target as Element | null)?.closest("[data-field] input");
    if (!input) return;
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      void runSearch((input as HTMLInputElement).value);
    }, 140);
  }

  doc.addEventListener("click", handleClick);
  doc.addEventListener("keydown", handleKeydown);
  doc.addEventListener("input", handleInput);

  /* The dialog and the drawer are fixed to the viewport, but Astro renders them
     inside the fixed header, which slides away as the page scrolls and took both
     overlays with it. Parked on the body, they stay on the screen. */
  function parkOverlays(): void {
    for (const selector of ["[data-search-dialog]", "#sx-drawer"]) {
      const overlay = doc.querySelector(selector);
      if (overlay && overlay.parentElement !== doc.body) doc.body.append(overlay);
    }
  }

  parkOverlays();

  // Hover opens a dropdown where there is a real pointer; leaving the nav closes it.
  if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    doc.addEventListener("pointerover", (event) => {
      const item = (event.target as Element | null)?.closest?.("[data-menu]");
      if (!item) return;
      if (item.querySelector("[data-menu-trigger]")?.getAttribute("aria-expanded") === "true") return;
      openMenu(item);
    });

    doc.addEventListener("pointerout", (event) => {
      const item = (event.target as Element | null)?.closest?.("[data-menu]");
      if (!item) return;
      const next = event.relatedTarget as Element | null;
      if (next && (item.contains(next) || next.closest?.(".sx-nav"))) return;
      closeMenus();
    });
  }

  doc.addEventListener("select:change", (event) => {
    const select = (event.target as Element | null)?.closest?.("[data-select]");
    if (!select || select.getAttribute("data-select-name") !== "theme") return;
    const detail = (event as CustomEvent<{ value: string }>).detail;
    applyTheme(detail.value);
  });

  doc.addEventListener("astro:page-load", () => {
    parkOverlays();
    lockScroll(false);
    closeEverything();
    syncThemeSelects(storedTheme());
  });

  syncThemeSelects(storedTheme());
</script>


<script>
  /**
   * The benchmark chart.
   *
   * The performance page carries its measurements as a table, rendered by the
   * sync from Sendust's own QA record. This reads that table and draws it as
   * bars above it: no number is written twice, so the picture cannot drift from
   * the data, and a page served without JavaScript keeps the table untouched.
   */
  const doc = document;

  interface BenchRow {
    label: string;
    detail: string;
    sendust: number;
    nodemailer: number;
  }

  function cellsOf(row: HTMLTableRowElement): HTMLTableCellElement[] {
    return Array.from(row.cells);
  }

  function numeric(text: string | null | undefined): number {
    const value = Number((text ?? "").replace(/[^0-9.]/g, ""));
    return Number.isFinite(value) ? value : 0;
  }

  function readRows(table: HTMLTableElement): BenchRow[] | null {
    const head = table.tHead?.rows[0];
    if (!head) return null;

    const labels = cellsOf(head).map((cell) => (cell.textContent ?? "").trim().toLowerCase());
    const sendust = labels.findIndex((label) => label.includes("sendust msg/s"));
    const nodemailer = labels.findIndex((label) => label.includes("nodemailer msg/s"));
    if (sendust < 0 || nodemailer < 0) return null;

    const concurrency = labels.findIndex((label) => label.startsWith("concurrency"));
    const messages = labels.findIndex((label) => label === "messages");
    const body = table.tBodies[0];
    if (!body) return null;

    const rows: BenchRow[] = [];
    for (const row of Array.from(body.rows)) {
      const values = cellsOf(row);
      const sendustValue = numeric(values[sendust]?.textContent);
      if (sendustValue <= 0) continue;

      const parts: string[] = [];
      if (concurrency >= 0) {
        parts.push(`${numeric(values[concurrency]?.textContent)} in flight`);
      }
      if (messages >= 0) {
        parts.push(`${numeric(values[messages]?.textContent).toLocaleString()} messages`);
      }

      rows.push({
        label: (values[0]?.textContent ?? "").trim(),
        detail: parts.join(", "),
        sendust: sendustValue,
        nodemailer: numeric(values[nodemailer]?.textContent),
      });
    }

    return rows.length > 0 ? rows : null;
  }

  function format(value: number): string {
    return Math.round(value).toLocaleString();
  }

  function bar(kind: string, value: number, max: number): HTMLElement {
    const line = doc.createElement("div");
    line.className = `sx-bench__bar sx-bench__bar--${kind}`;

    const track = doc.createElement("span");
    track.className = "sx-bench__track";

    const fill = doc.createElement("span");
    fill.className = "sx-bench__fill";
    fill.style.setProperty("--w", `${((value / max) * 100).toFixed(2)}%`);
    track.append(fill);

    const number = doc.createElement("span");
    number.className = "sx-bench__num";
    number.textContent = "0";
    number.dataset.value = String(value);

    line.append(track, number);
    return line;
  }

  function build(rows: BenchRow[]): HTMLElement {
    const max = Math.max(...rows.flatMap((row) => [row.sendust, row.nodemailer]));

    const figure = doc.createElement("figure");
    figure.className = "sx-bench";
    figure.dataset.sxBench = "";

    const head = doc.createElement("div");
    head.className = "sx-bench__head";

    const title = doc.createElement("p");
    title.className = "sx-bench__title";
    title.textContent = "Accepted messages per second";

    const legend = doc.createElement("p");
    legend.className = "sx-bench__legend";
    for (const [kind, label] of [
      ["sendust", "Sendust"],
      ["nodemailer", "Nodemailer"],
    ]) {
      const key = doc.createElement("span");
      key.className = "sx-bench__key";
      const dot = doc.createElement("i");
      dot.className = `sx-bench__dot sx-bench__dot--${kind}`;
      key.append(dot, doc.createTextNode(label));
      legend.append(key);
    }
    head.append(title, legend);

    const list = doc.createElement("ol");
    list.className = "sx-bench__rows";

    for (const row of rows) {
      const item = doc.createElement("li");
      item.className = "sx-bench__row";

      const label = doc.createElement("p");
      label.className = "sx-bench__label";
      label.textContent = row.label;
      if (row.detail !== "") {
        const detail = doc.createElement("span");
        detail.textContent = row.detail;
        label.append(detail);
      }

      const pair = doc.createElement("div");
      pair.className = "sx-bench__pair";
      pair.append(bar("sendust", row.sendust, max), bar("nodemailer", row.nodemailer, max));

      item.append(label, pair);
      list.append(item);
    }

    const note = doc.createElement("p");
    note.className = "sx-bench__note";
    note.textContent =
      "Drawn from the table below: accepted messages per second on one machine against a loopback relay. Relay acceptance only, not a delivery claim.";

    figure.append(head, list, note);
    return figure;
  }

  function countUp(el: HTMLElement): void {
    const target = Number(el.dataset.value ?? "0");
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.textContent = format(target);
      return;
    }

    const start = performance.now();
    const step = (now: number): void => {
      const progress = Math.min(1, (now - start) / 900);
      const eased = 1 - (1 - progress) ** 3;
      el.textContent = format(target * eased);
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  function reveal(figure: HTMLElement): void {
    if (figure.dataset.live === "true") return;
    figure.dataset.live = "true";
    figure.classList.add("is-live");
    for (const el of figure.querySelectorAll<HTMLElement>(".sx-bench__num")) countUp(el);
  }

  function boot(): void {
    for (const table of doc.querySelectorAll<HTMLTableElement>(".sl-markdown-content table")) {
      if (table.previousElementSibling?.matches("[data-sx-bench]")) continue;

      const rows = readRows(table);
      if (!rows) continue;

      const figure = build(rows);
      table.before(figure);

      const observer = new IntersectionObserver(
        (entries, self) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            reveal(figure);
            self.disconnect();
          }
        },
        { threshold: 0.25 },
      );
      observer.observe(figure);
    }
  }

  boot();
  doc.addEventListener("astro:page-load", boot);
</script>


<script>
  /**
   * The motion layer, on Motion (motion.dev).
   *
   * It is progressive and additive: the page is complete without it. Every
   * effect is opt-in through `html[data-motion="on"]`, so reduced-motion
   * visitors, and anyone whose module never loads, see a finished static page
   * rather than a page waiting to animate in.
   *
   * What it drives, and why these primitives and not more:
   *  - `scroll` + `clamp` for the reading line, which CSS cannot express.
   *  - `inView` + `stagger` + `animate` for groups that should arrive in order
   *    as they enter the viewport, which `animation-timeline` only approximates.
   * Cheap state changes (hover, press, colour) stay in CSS: they need no
   * sequencing, and putting them in JavaScript would only add handlers.
   */
  import { animate, clamp, inView, scroll, stagger } from "motion";

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const root = document.documentElement;
  const EASE = [0.22, 0.61, 0.36, 1] as const;

  /** Groups revealed on entry: card grids, fact rows, and section headings. */
  const GROUP_SELECTOR = "[data-motion-group], .card-grid, .sx-facts, .sl-markdown-content > h2";

  let stops: Array<() => void> = [];

  function itemsOf(group: Element): Element[] {
    if (group.matches("[data-motion-group]")) {
      return [...group.querySelectorAll<HTMLElement>("[data-motion-item]")];
    }
    const children = [...group.children];
    return children.length > 0 ? children : [group];
  }

  function boot(): void {
    for (const stop of stops) stop();
    stops = [];

    if (prefersReduced.matches) {
      root.removeAttribute("data-motion");
      // A visitor who turns motion down mid-visit must not be left with blocks
      // held at the starting state.
      doc.querySelectorAll<HTMLElement>(".sx-journey").forEach((block) => {
        block.style.removeProperty("opacity");
        block.style.removeProperty("transform");
      });
      return;
    }

    root.setAttribute("data-motion", "on");

    // The reading line. Created here so no page carries decorative markup for it.
    let bar = document.querySelector<HTMLElement>("[data-motion-progress]");
    if (!bar) {
      bar = document.createElement("span");
      bar.dataset.motionProgress = "";
      bar.setAttribute("aria-hidden", "true");
      document.body.append(bar);
    }
    const paint = (): void => {
      const max = root.scrollHeight - window.innerHeight;
      const progress = max > 0 ? clamp(0, 1, window.scrollY / max) : 0;
      bar.style.transform = `scaleX(${progress.toFixed(4)})`;
    };
    paint();
    stops.push(scroll(paint));

    // The journey: every substantial block arrives with a short zoom, so a long
    // page reads as a sequence of stops rather than one uninterrupted scroll.
    // The initial state is set here, not in CSS, so a visitor whose module never
    // runs sees a finished page instead of an empty one.
    const FROM = { opacity: 0, transform: "scale(0.955) translateY(22px)" };
    const TO = { opacity: 1, transform: "scale(1) translateY(0px)" };

    const journey = [
      ...document.querySelectorAll<HTMLElement>(
        ".sx-landing > *, .sl-markdown-content > :is(table, figure, blockquote, .expressive-code)",
      ),
    ].filter((block) => !block.matches("[data-intro]") && block.offsetHeight > 140);

    for (const block of journey) {
      // A block on the first screen paints as it is. Holding it at zero opacity
      // until a frame runs would leave the top of the page blank in a tab that
      // is not on screen yet, and the hero must never wait to be revealed.
      if (block.getBoundingClientRect().top < window.innerHeight) continue;

      block.classList.add("sx-journey");
      block.style.opacity = String(FROM.opacity);
      block.style.transform = FROM.transform;

      const arrive = (): void => {
        animate(block, { opacity: [FROM.opacity, 1], transform: [FROM.transform, TO.transform] }, {
          duration: 0.62,
          ease: EASE,
        });
      };

      let stop = (): void => {};
      stop = inView(
        block,
        () => {
          stop();
          arrive();
        },
        { amount: 0.15 },
      );
      stops.push(() => stop());
    }

    // The hero lets go as it leaves: a small zoom out, so the block that follows
    // is the one in focus.
    const hero = document.querySelector<HTMLElement>(".sx-hero");
    if (hero) {
      const focusHero = (): void => {
        const height = hero.offsetHeight || 1;
        const progress = Math.min(1, Math.max(0, window.scrollY / height));
        hero.style.setProperty("--sx-hero-focus", (1 - progress * 0.05).toFixed(3));
        hero.style.setProperty("--sx-hero-fade", (1 - progress * 0.45).toFixed(3));
      };
      focusHero();
      stops.push(scroll(focusHero));
    }

    // Reveals: a group's items rise in order, once each.
    for (const group of document.querySelectorAll(GROUP_SELECTOR)) {
      const items = itemsOf(group);
      if (items.length === 0) continue;

      stops.push(
        inView(
          group,
          () => {
            animate(
              items,
              { opacity: [0, 1], transform: ["translateY(18px)", "translateY(0px)"] },
              { duration: 0.55, delay: stagger(0.07), ease: EASE },
            );
          },
          { amount: 0.2 },
        ),
      );
    }
  }

  boot();
  document.addEventListener("astro:page-load", boot);
  prefersReduced.addEventListener("change", boot);
</script>


<script>
  /**
   * Two behaviours the click layer cannot cover.
   *
   * 1. The theme is stored in `starlight-theme`, but a client-side navigation
   *    swapped the page while the picker's markup says "dark", so the choice
   *    looked like it reset. Re-apply the stored value on every page load; the
   *    markup is not allowed to win over what the reader chose.
   * 2. The header dropdowns open on hover, and a pointer that crosses the gap
   *    between the trigger and the panel stops hovering both. Pointer intent
   *    with a short close delay keeps the panel up across that gap.
   */

  const doc = document;

  function storedMode(): string | null {
    try {
      const stored = localStorage.getItem("starlight-theme");
      if (stored === null) return null;
      return stored === "" || stored === "auto" ? "auto" : stored;
    } catch {
      return null;
    }
  }

  function applyStoredTheme(): void {
    const mode = storedMode();
    if (mode === null) return;
    const resolved =
      mode === "auto"
        ? window.matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark"
        : mode;
    doc.documentElement.dataset.theme = resolved;
  }

  const closeTimers = new WeakMap<Element, number>();

  function openMenu(item: Element): void {
    const pending = closeTimers.get(item);
    if (pending) {
      window.clearTimeout(pending);
      closeTimers.delete(item);
    }
    item.setAttribute("data-open", "");
    item.querySelector("[data-menu-trigger]")?.setAttribute("aria-expanded", "true");
  }

  function scheduleClose(item: Element): void {
    const pending = closeTimers.get(item);
    if (pending) window.clearTimeout(pending);
    closeTimers.set(
      item,
      window.setTimeout(() => {
        item.removeAttribute("data-open");
        item.querySelector("[data-menu-trigger]")?.setAttribute("aria-expanded", "false");
      }, 180),
    );
  }

  function bindHoverMenus(): void {
    // Only where a real pointer can hover: on touch, the click layer owns this.
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;

    for (const item of doc.querySelectorAll<HTMLElement>("[data-menu]")) {
      if (item.dataset.hoverBound === "true") continue;
      if (!item.querySelector("[data-menu-panel]")) continue;
      item.dataset.hoverBound = "true";
      item.addEventListener("pointerenter", () => openMenu(item));
      item.addEventListener("pointerleave", () => scheduleClose(item));
      item.addEventListener("focusin", () => openMenu(item));
      item.addEventListener("focusout", (event) => {
        if (!item.contains(event.relatedTarget as Node | null)) scheduleClose(item);
      });
    }
  }

  function boot(): void {
    applyStoredTheme();
    bindHoverMenus();
  }

  boot();
  doc.addEventListener("astro:page-load", boot);
</script>
