---
/**
 * A liquid panel: obsidian water held in a clipped, rounded frame.
 *
 * The light pools are plain radial gradients — no blur filters to pay for —
 * drifting on transforms only. The waves at the edges are the page colour
 * eating into the water, and the grain is one static tile, so nothing here
 * repaints while it moves.
 */
interface Props {
  label?: string;
  edges?: "bottom" | "both" | "none";
}

const { label, edges = "both" } = Astro.props;
---

<section class="sx-liquid" aria-label={label}>
  <span class="sx-liquid__pools" aria-hidden="true">
    <span class="sx-liquid__pool sx-liquid__pool--a"></span>
    <span class="sx-liquid__pool sx-liquid__pool--b"></span>
    <span class="sx-liquid__pool sx-liquid__pool--c"></span>
  </span>
  <span class="sx-liquid__grain" aria-hidden="true"></span>

  {
    edges !== "bottom" && edges !== "none" && (
      <span class="sx-liquid__wave sx-liquid__wave--top" aria-hidden="true">
        <svg viewBox="0 0 400 20" preserveAspectRatio="none">
          <path d="M0 10 C 25 0, 25 20, 50 10 S 75 0, 100 10 S 125 20, 150 10 S 175 0, 200 10 S 225 20, 250 10 S 275 0, 300 10 S 325 20, 350 10 S 375 0, 400 10 V 20 H 0 Z" />
          <path d="M0 10 C 25 0, 25 20, 50 10 S 75 0, 100 10 S 125 20, 150 10 S 175 0, 200 10 S 225 20, 250 10 S 275 0, 300 10 S 325 20, 350 10 S 375 0, 400 10 V 20 H 0 Z" transform="translate(400 0)" />
        </svg>
      </span>
    )
  }

  <div class="sx-liquid__inner"><slot /></div>

  {
    edges !== "none" && (
      <span class="sx-liquid__wave sx-liquid__wave--bottom" aria-hidden="true">
        <svg viewBox="0 0 400 20" preserveAspectRatio="none">
          <path d="M0 10 C 25 0, 25 20, 50 10 S 75 0, 100 10 S 125 20, 150 10 S 175 0, 200 10 S 225 20, 250 10 S 275 0, 300 10 S 325 20, 350 10 S 375 0, 400 10 V 20 H 0 Z" />
          <path d="M0 10 C 25 0, 25 20, 50 10 S 75 0, 100 10 S 125 20, 150 10 S 175 0, 200 10 S 225 20, 250 10 S 275 0, 300 10 S 325 20, 350 10 S 375 0, 400 10 V 20 H 0 Z" transform="translate(400 0)" />
        </svg>
      </span>
    )
  }
</section>
