---
/**
 * The statement band: the one raised surface on the landing page. It is a
 * hairline panel on the canvas now, no pools, no grain, no waterline. The
 * component keeps its name because the prose it carries is still a statement.
 */
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<section class="sx-liquid" aria-label={label}>
  <div class="sx-liquid__inner"><slot /></div>
</section>
