---
/** A strip of small technical facts: versions, targets, one-line guarantees. */
interface Props {
  items: string[];
  label?: string;
}

const { items, label = "At a glance" } = Astro.props;
---

<ul class="sx-facts" aria-label={label}>
  {
    items.map((item) => (
      <li>
        <span class="sx-facts__dot" aria-hidden="true" />
        {item}
      </li>
    ))
  }
</ul>
